# Copia este fichero a .env (no lo subas al repositorio) o define las variables en tu plataforma.
# Comprueba la configuración con:  NODE_ENV=production npm run preflight

NODE_ENV=production
PORT=8080
HOST=0.0.0.0
BASE_URL=https://tudominio.es
DATA_DIR=/data
# 1 si hay un proxy inverso delante (Fly.io, Caddy, Nginx): se usa la última IP de X-Forwarded-For.
TRUST_PROXY=1

# Secreto aleatorio de 64 caracteres hexadecimales. NO cambiarlo después: invalidaría las licencias emitidas.
# Genéralo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Datos del titular (aviso legal, LSSI art. 10). Obligatorios para publicar.
OWNER_NAME=
OWNER_TAX_ID=
OWNER_ADDRESS=
OWNER_EMAIL=
SUPPORT_EMAIL=

# Correo saliente (licencias, avisos, alertas e informe diario).
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=RemesaLista <hola@tudominio.es>
ADMIN_EMAIL=

# Pagos con Stripe (Payment Link o Checkout + webhook). Déjalos vacíos para mostrar la lista de espera.
# Eventos del webhook: checkout.session.completed, checkout.session.async_payment_succeeded, customer.subscription.deleted
CHECKOUT_URL=
STRIPE_WEBHOOK_SECRET=
PRO_PRICE_LABEL=

# Límites de los planes (valores por defecto).
FREE_MAX_TRANSACTIONS=25
PRO_MAX_TRANSACTIONS=5000
FREE_GENERATIONS_PER_HOUR=20
PRO_GENERATIONS_PER_HOUR=300
PRO_PASS_DAYS=365

# Token para ver el detalle de /healthz (cabecera Authorization: Bearer <token>).
HEALTH_TOKEN=
BACKUP_RETENTION_DAYS=14
